# Configure the EmailJS template to use {{to_email}} as the recipient and
# {{subject}} as the email subject. contact@rourtech.com is always included.
# Optional: add additional notification recipients, separated by commas.
# These NEXT_PUBLIC_ values are browser-visible; only use the EmailJS public key.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
NEXT_PUBLIC_EMAILJS_TO_EMAIL=
